{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suzuran Cloud Application Manifest",
  "description": "应用清单文件 app.json 的 JSON Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "应用名称（小写字母、数字、连字符）"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "语义化版本号"
    },
    "runtime": {
      "type": "string",
      "enum": ["node:18", "node:20", "python:3.11", "go:1.21"],
      "description": "运行时环境"
    },
    "entrypoint": {
      "type": "string",
      "description": "启动命令，如 node server.js"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "description": "应用监听端口"
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "description": "CPU 配额，如 0.5 表示 50% 一个核心"
        },
        "memory": {
          "type": "string",
          "pattern": "^\\d+(Ki|Mi|Gi)$",
          "description": "内存配额，如 512Mi"
        },
        "database_connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "数据库连接池配额"
        }
      },
      "required": ["cpu", "memory"]
    },
    "mcp_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["openid", "org.read", "org.write", "file.read", "file.write", "audit.read", "audit.write"]
      },
      "description": "应用所需的 MCP 权限范围"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "路由路径，如 /api/*" },
          "handler": { "type": "string", "description": "处理者地址" }
        },
        "required": ["path", "handler"]
      },
      "description": "外部请求路由配置"
    }
  },
  "required": ["name", "version", "runtime", "entrypoint", "port"]
}
