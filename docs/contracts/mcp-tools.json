{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suzuran Cloud MCP Tools",
  "description": "平台通过 MCP Server 暴露的所有数据访问工具。应用通过 POST /mcp 调用，每次调用需携带 OAuth access token。",
  "version": "1.0.0",
  "transport": {
    "endpoint": "POST /mcp",
    "protocol": "JSON-RPC 2.0",
    "auth": "Authorization: Bearer <access_token>",
    "content_type": "application/json"
  },
  "calling_convention": {
    "request_example": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "tools/call",
      "params": {
        "name": "org.get",
        "arguments": { "orgId": 1 }
      }
    },
    "response_example": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "content": [{ "type": "text", "text": "{\"id\":1,\"name\":\"演示服务商\"}" }]
      }
    }
  },
  "scopes": [
    "org.read", "org.write",
    "file.read", "file.write",
    "audit.read", "audit.write"
  ],
  "tools": [
    {
      "name": "org.get",
      "description": "获取组织详情",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" }
        },
        "required": ["orgId"]
      }
    },
    {
      "name": "org.list",
      "description": "列出所有组织（仅 provider 角色）",
      "required_scope": "org.read",
      "required_role": "provider",
      "input": { "type": "object", "properties": {} }
    },
    {
      "name": "org.create",
      "description": "创建组织（仅 provider 角色）",
      "required_scope": "org.write",
      "required_role": "provider",
      "input": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["name"]
      }
    },
    {
      "name": "org.update",
      "description": "更新组织信息（仅 provider 角色）",
      "required_scope": "org.write",
      "required_role": "provider",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["orgId"]
      }
    },
    {
      "name": "org.delete",
      "description": "删除组织（仅 provider 角色）",
      "required_scope": "org.write",
      "required_role": "provider",
      "input": {
        "type": "object",
        "properties": { "orgId": { "type": "integer" } },
        "required": ["orgId"]
      }
    },
    {
      "name": "user.list_members",
      "description": "列出组织内所有成员",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": { "orgId": { "type": "integer" } },
        "required": ["orgId"]
      }
    },
    {
      "name": "user.create_member",
      "description": "创建组织成员",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "phone": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "position": { "type": "string" },
          "isAdmin": { "type": "boolean", "default": false },
          "departmentId": { "type": "integer" },
          "isDepartmentManager": { "type": "boolean", "default": false }
        },
        "required": ["orgId", "phone", "name"]
      }
    },
    {
      "name": "user.update_member",
      "description": "更新成员信息",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "userId": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "position": { "type": "string" },
          "isAdmin": { "type": "boolean" },
          "departmentId": { "type": "integer" },
          "isDepartmentManager": { "type": "boolean" }
        },
        "required": ["orgId", "userId"]
      }
    },
    {
      "name": "user.remove_member",
      "description": "从组织移除成员",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "userId": { "type": "integer" }
        },
        "required": ["orgId", "userId"]
      }
    },
    {
      "name": "dept.list",
      "description": "列出组织内所有部门",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": { "orgId": { "type": "integer" } },
        "required": ["orgId"]
      }
    },
    {
      "name": "dept.get",
      "description": "获取部门详情",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": { "deptId": { "type": "integer" } },
        "required": ["deptId"]
      }
    },
    {
      "name": "dept.tree",
      "description": "获取组织部门树结构",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": { "orgId": { "type": "integer" } },
        "required": ["orgId"]
      }
    },
    {
      "name": "dept.create",
      "description": "创建部门",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "name": { "type": "string" },
          "parentId": { "type": "integer" },
          "level": { "type": "integer", "default": 1 },
          "description": { "type": "string" }
        },
        "required": ["orgId", "name"]
      }
    },
    {
      "name": "dept.update",
      "description": "更新部门信息",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "deptId": { "type": "integer" },
          "name": { "type": "string" },
          "parentId": { "type": "integer" },
          "level": { "type": "integer" },
          "description": { "type": "string" }
        },
        "required": ["deptId"]
      }
    },
    {
      "name": "dept.delete",
      "description": "删除部门",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": { "deptId": { "type": "integer" } },
        "required": ["deptId"]
      }
    },
    {
      "name": "dept.set_manager",
      "description": "设置部门经理",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "deptId": { "type": "integer" },
          "managerUserId": { "type": "integer" }
        },
        "required": ["deptId", "managerUserId"]
      }
    },
    {
      "name": "file.upload",
      "description": "上传文件到对象存储",
      "required_scope": "file.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "fileName": { "type": "string" },
          "fileBase64": { "type": "string", "description": "文件内容 base64 编码" },
          "contentType": { "type": "string" }
        },
        "required": ["orgId", "fileName", "fileBase64", "contentType"]
      }
    },
    {
      "name": "file.download",
      "description": "获取文件下载的预签名 URL",
      "required_scope": "file.read",
      "input": {
        "type": "object",
        "properties": {
          "objectKey": { "type": "string" },
          "expiryMinutes": { "type": "integer", "default": 60 }
        },
        "required": ["objectKey"]
      }
    },
    {
      "name": "file.delete",
      "description": "删除文件",
      "required_scope": "file.write",
      "input": {
        "type": "object",
        "properties": { "objectKey": { "type": "string" } },
        "required": ["objectKey"]
      }
    },
    {
      "name": "file.list",
      "description": "列出组织文件（待实现）",
      "required_scope": "file.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "prefix": { "type": "string" },
          "limit": { "type": "integer", "default": 100 },
          "offset": { "type": "integer", "default": 0 }
        },
        "required": ["orgId"]
      }
    },
    {
      "name": "file.presigned_url",
      "description": "生成文件预签名访问 URL",
      "required_scope": "file.read",
      "input": {
        "type": "object",
        "properties": {
          "objectKey": { "type": "string" },
          "expiryMinutes": { "type": "integer", "default": 60 }
        },
        "required": ["objectKey"]
      }
    },
    {
      "name": "audit.query",
      "description": "查询审计日志",
      "required_scope": "audit.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "userId": { "type": "integer" },
          "action": { "type": "string" },
          "resourceType": { "type": "string" },
          "startTime": { "type": "string", "format": "date-time" },
          "endTime": { "type": "string", "format": "date-time" },
          "limit": { "type": "integer", "default": 100 },
          "offset": { "type": "integer", "default": 0 }
        }
      }
    },
    {
      "name": "audit.log",
      "description": "记录自定义审计日志条目",
      "required_scope": "audit.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "action": { "type": "string" },
          "resourceType": { "type": "string" },
          "resourceId": { "type": "integer" },
          "metadata": { "type": "object" }
        },
        "required": ["orgId", "action", "resourceType"]
      }
    }
  ]
}
