{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowInstance",
  "description": "流程实例——单次运行（或已结束）的执行记录（Spec 06）",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "实例 ID" },
    "orgId": { "type": "integer", "description": "所属组织 ID" },
    "definitionId": { "type": "integer", "description": "关联定义 ID" },
    "status": {
      "type": "string",
      "enum": ["running", "approved", "rejected", "cancelled"],
      "description": "实例状态"
    },
    "currentStep": { "type": "string", "description": "当前步骤名" },
    "variables": { "type": "object", "description": "流程变量（业务数据）" },
    "createdBy": { "type": "integer", "description": "发起人 user_id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time", "description": "完成时间（运行中时为 null）" }
  },
  "required": ["id", "orgId", "definitionId", "status"]
}
