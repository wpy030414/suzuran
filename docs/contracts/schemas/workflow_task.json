{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowTask",
  "description": "流程任务——审批步骤的人工待办（Spec 06）",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "任务 ID" },
    "orgId": { "type": "integer", "description": "所属组织 ID" },
    "instanceId": { "type": "integer", "description": "关联实例 ID" },
    "stepName": { "type": "string", "description": "步骤名" },
    "assigneeId": { "type": "integer", "description": "被指派人 user_id" },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected"],
      "description": "任务状态"
    },
    "comment": { "type": "string", "description": "审批意见" },
    "createdAt": { "type": "string", "format": "date-time" },
    "actedAt": { "type": "string", "format": "date-time", "description": "操作时间（pending 时为 null）" }
  },
  "required": ["id", "orgId", "instanceId", "stepName", "assigneeId", "status"]
}
