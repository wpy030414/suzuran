{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Department",
  "description": "部门数据模型（树形结构）",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "部门 ID" },
    "orgId": { "type": "integer", "description": "所属组织 ID" },
    "name": { "type": "string", "description": "部门名称" },
    "parentId": { "type": ["integer", "null"], "description": "父部门 ID（根部门为 null）" },
    "level": { "type": "integer", "default": 1, "description": "层级" },
    "managerUserId": { "type": ["integer", "null"], "description": "部门经理用户 ID" },
    "description": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "orgId", "name"]
}
