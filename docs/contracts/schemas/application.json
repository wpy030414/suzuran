{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application",
  "description": "应用数据模型（AI 原生应用，非低代码）",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "应用 ID (UUID)" },
    "orgId": { "type": "integer", "description": "所属组织 ID" },
    "name": { "type": "string", "description": "应用名称" },
    "version": { "type": "string", "description": "版本号" },
    "runtime": { "type": "string", "description": "运行时，如 node:18" },
    "entrypoint": { "type": "string", "description": "启动命令" },
    "port": { "type": "integer", "description": "容器监听端口" },
    "cpuQuota": { "type": "string", "description": "CPU 配额，如 0.5" },
    "memoryQuota": { "type": "string", "description": "内存配额，如 512Mi" },
    "dbConnQuota": { "type": "integer", "description": "数据库连接配额" },
    "mcpScopes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "MCP 权限范围"
    },
    "routes": {
      "type": "object",
      "description": "路由配置"
    },
    "status": {
      "type": "string",
      "enum": ["created", "building", "running", "stopped", "error", "deleted"],
      "description": "应用状态"
    },
    "containerId": { "type": "string", "description": "Docker 容器 ID（仅 provider 可见）" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "orgId", "name", "status"]
}
