{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User",
  "description": "用户数据模型（OAuth-only，无密码字段）",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "用户 ID" },
    "name": { "type": "string", "description": "用户名" },
    "phone": { "type": "string", "description": "手机号" },
    "email": { "type": "string", "format": "email", "description": "邮箱" },
    "emailVerified": { "type": "boolean", "default": false },
    "position": { "type": "string", "description": "职位" },
    "avatarUrl": { "type": "string", "format": "uri", "description": "头像 URL" },
    "dingtalkUserId": { "type": ["string", "null"], "description": "钉钉用户 ID" },
    "dingtalkUnionId": { "type": ["string", "null"], "description": "钉钉_unionid" },
    "dingtalkOpenId": { "type": ["string", "null"], "description": "钉钉 openid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "name"]
}
