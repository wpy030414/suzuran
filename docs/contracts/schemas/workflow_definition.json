{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowDefinition",
  "description": "流程定义——JSON 定义 + MCP 驱动的程序化流程引擎蓝图（Spec 06）",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "定义 ID" },
    "orgId": { "type": "integer", "description": "所属组织 ID（租户隔离）" },
    "name": { "type": "string", "description": "流程名称" },
    "description": { "type": "string", "description": "流程描述" },
    "definition": {
      "type": "object",
      "description": "流程定义 JSON：{ name, variables:{}, steps:[{name,type,next,assignee,on_approve,on_reject,conditions,result}] }",
      "properties": {
        "name": { "type": "string" },
        "variables": {
          "type": "object",
          "description": "变量名 -> 类型(number/string)",
          "additionalProperties": { "type": "string" }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "步骤名（唯一）" },
              "type": { "type": "string", "enum": ["start", "approval", "condition", "end"] },
              "next": { "type": "string", "description": "下一步骤名（start 类型必填）" },
              "assignee": {
                "type": "object",
                "description": "指派（approval 必填）",
                "properties": {
                  "type": { "type": "string", "enum": ["user", "role"] },
                  "value": { "type": "string", "description": "user_id 字符串或角色名（org_admin/dept_manager/provider_admin）" }
                },
                "required": ["type", "value"]
              },
              "on_approve": { "type": "object", "properties": { "goto": { "type": "string" } }, "required": ["goto"] },
              "on_reject": { "type": "object", "properties": { "goto": { "type": "string" } }, "required": ["goto"] },
              "conditions": {
                "type": "array",
                "description": "条件分支（condition 必填），按顺序求值，命中第一个后跳转",
                "items": {
                  "type": "object",
                  "properties": {
                    "when": { "type": "string", "description": "表达式，如 leaveDays > 3" },
                    "goto": { "type": "string" },
                    "otherwise": { "type": "string", "description": "兜底跳转目标" }
                  }
                }
              },
              "result": { "type": "string", "enum": ["approved", "rejected", "cancelled"], "description": "终点结果（end 必填）" }
            },
            "required": ["name", "type"]
          }
        }
      },
      "required": ["name", "steps"]
    },
    "version": { "type": "integer", "description": "版本号" },
    "status": { "type": "string", "enum": ["active", "archived"] },
    "createdBy": { "type": "integer" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "orgId", "name", "definition", "status"]
}
