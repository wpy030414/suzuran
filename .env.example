# PostgreSQL 数据库配置
DATABASE_URL=host=localhost user=admin password=changeme dbname=suzuran_cloud port=5432 sslmode=disable
DB_PASSWORD=changeme

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=changeme

# MinIO 对象存储配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=suzuran-files

# OAuth IdP 配置
# Issuer：平台对外 URL（生产环境务必改为真实域名）
OAUTH_ISSUER=http://localhost:8888

# WebAuthn (Passkey) 配置
# RP ID 必须是访问平台的域名（开发环境用 localhost）
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME=Suzuran Cloud
# 允许的 Origin（逗号分隔）
WEBAUTHN_RP_ORIGINS=http://localhost:5173,http://localhost:3000

# 钉钉 OAuth 配置
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# 钉钉 Bot Webhook（可选）
DINGTALK_BOT_WEBHOOK=

# 后端服务端口
PORT=8888
